<Window x:Class="UniversalPrint.App.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create print invoice"
        Height="760"
        Width="720"
        MinHeight="640"
        MinWidth="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    IsCancel="True"
                    Padding="16,8"
                    Margin="0,0,8,0"/>
            <Button Content="Save invoice PDF"
                    IsDefault="True"
                    Padding="18,8"
                    Click="SaveInvoice_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Create invoice"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Enter the business and final print details. Page counts are entered manually until document page counting is available."
                           TextWrapping="Wrap"
                           Foreground="DimGray"
                           Margin="0,6,0,18"/>

                <TextBlock Text="Your business"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Business name *"/>
                <TextBox x:Name="SellerNameTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Business address"/>
                <TextBox x:Name="SellerAddressTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Email or phone"/>
                <TextBox x:Name="SellerContactTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Tax registration ID"/>
                <TextBox x:Name="SellerTaxIdTextBox" Margin="0,3,0,16"/>

                <TextBlock Text="Customer (optional)"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Customer name"/>
                <TextBox x:Name="CustomerNameTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Customer address"/>
                <TextBox x:Name="CustomerAddressTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Customer tax ID"/>
                <TextBox x:Name="CustomerTaxIdTextBox" Margin="0,3,0,16"/>

                <TextBlock Text="Print and pricing"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Total pages per copy *"/>
                <TextBox x:Name="PagesTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Number of copies *"/>
                <TextBox x:Name="CopiesTextBox" Text="1" Margin="0,3,0,8"/>
                <TextBlock Text="Price per page *"/>
                <TextBox x:Name="PricePerPageTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Tax rate (%)"/>
                <TextBox x:Name="TaxRateTextBox" Text="0" Margin="0,3,0,8"/>
                <TextBlock Text="Currency code (three letters) *"/>
                <TextBox x:Name="CurrencyCodeTextBox" Margin="0,3,0,8"/>
                <TextBlock Text="Tax is optional and defaults to 0%. Enter the rate and registration information applicable to your business."
                           TextWrapping="Wrap"
                           Foreground="DimGray"
                           Margin="0,2,0,16"/>

                <TextBlock Text="Files in this print job"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ItemsControl x:Name="FilesItemsControl"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
